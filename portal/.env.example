# Salin ke .env (JANGAN commit .env asli — sudah di-gitignore) dan isi nilai lokal/dev kamu.

# Postgres lokal — sertakan user & sslmode=disable eksplisit (schema engine
# Prisma 7 tidak fallback ke peer-auth OS user seperti psql CLI).
DATABASE_URL="postgresql://USER@localhost:5432/inggrisinyuk_kids_portal?sslmode=disable"

# Rahasia untuk menandatangani JWT sesi login — string acak panjang, beda per environment.
# Generate cepat: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-rahasia-acak-panjang"

# Origin app/ (statis, esbuild) yang boleh manggil API ini lewat fetch (CORS).
# Default cocok utk `npm run dev` di app/ (lihat app/README.md).
APP_ORIGIN="http://127.0.0.1:8200"

# Pembayaran (halaman Daftar app anak) — Xendit Invoice. Ambil dari Dashboard
# Xendit → Settings → API Keys (pakai key "Test" dulu, lalu "Live" di production).
XENDIT_SECRET_KEY="xnd_development_..."
# Dashboard Xendit → Settings → Webhooks → "Verification token".
XENDIT_WEBHOOK_TOKEN="..."
# Tes lokal TANPA Xendit: "1" = pembayaran dianggap langsung lunas. Otomatis
# mati kalau NODE_ENV=production.
XENDIT_MOCK="1"
