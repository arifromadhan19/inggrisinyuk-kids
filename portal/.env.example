# Salin ke .env (JANGAN commit .env asli — sudah di-gitignore) dan isi nilai lokal/dev kamu.

# Postgres lokal — sertakan user & sslmode=disable eksplisit (schema engine
# Prisma 7 tidak fallback ke peer-auth OS user seperti psql CLI).
DATABASE_URL="postgresql://USER@localhost:5432/inggrisinyuk_kids_portal?sslmode=disable"

# Rahasia untuk menandatangani JWT sesi login — string acak panjang, beda per environment.
# Generate cepat: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-rahasia-acak-panjang"

# Origin app/ (statis, esbuild) yang boleh manggil API ini lewat fetch (CORS).
# Default cocok utk `npm run dev` di app/ (lihat app/README.md).
APP_ORIGIN="http://127.0.0.1:8200"

# Pembayaran (halaman Daftar app anak) — Midtrans Snap. Ambil dari Dashboard
# Midtrans → (pilih Environment Sandbox/Production) → Settings → Access Keys.
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
# "true" = Production (uang asli). Selain itu = Sandbox.
MIDTRANS_IS_PRODUCTION="false"
# Tes lokal TANPA payment gateway: "1" = pembayaran dianggap langsung lunas.
# Otomatis mati kalau NODE_ENV=production.
PAYMENT_MOCK="1"

# ── Panel manajemen user (CS) ────────────────────────────────────────────
# URL panel = https://<domain-api>/<ADMIN_GATE>/  — BUKAN /admin. String acak
# min 24 karakter (huruf/angka/-/_). Kosong/pendek = panel mati (404).
# Generate: openssl rand -hex 16
ADMIN_GATE=""
# Rahasia sesi admin — WAJIB beda dari SESSION_SECRET. openssl rand -base64 48
ADMIN_SESSION_SECRET=""
# Opsional: batasi ke IP kantor/VPN (pisah koma). Kosong = semua IP.
ADMIN_IP_ALLOWLIST=""
